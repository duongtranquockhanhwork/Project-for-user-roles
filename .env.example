# Copy to .env and replace every value. .env is git-ignored.
# Generate strong values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# Database superuser - used only by the postgres container for initialisation
DBA_USER=uni_dba
DBA_PASSWORD=change-me-dba-password

# Low-privilege account used by the web application
APP_DB_PASSWORD=change-me-app-password

# Set to true when the application is served over HTTPS
COOKIE_SECURE=false
